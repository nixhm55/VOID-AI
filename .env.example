# Public client configuration (safe to ship with web, desktop, and mobile apps).
# Copy the Project URL and publishable key from Supabase Dashboard > Connect
# or Settings > API Keys > Publishable and secret API keys.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Configure provider credentials in Supabase Dashboard > Authentication >
# Sign In / Providers. These are intentionally not Vite variables and are not
# read by the frontend. The OAuth client secrets must stay in Supabase.
# Enable manual identity linking in Authentication > Settings to let guests
# keep their account when they add Google, GitHub, email, or phone sign-in.
# Create a Google OAuth client at https://console.cloud.google.com/apis/credentials
# GOOGLE_OAUTH_CLIENT_ID=...
# GOOGLE_OAUTH_CLIENT_SECRET=...
# Create a GitHub OAuth app at https://github.com/settings/developers
# GITHUB_OAUTH_CLIENT_ID=...
# GITHUB_OAUTH_CLIENT_SECRET=...
# Use the callback URL shown by each provider in the Supabase dashboard.

# Configure an SMS provider (for example Twilio) in Supabase Dashboard >
# Authentication > Sign In / Providers > Phone. Keep its credentials there.

# Server-side request-auth helper (same public project values; caller JWT still
# enforces RLS). Configure these in the backend runtime environment.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only model provider credentials. Never prefix these with VITE_.
OMNI_BASE_URL=https://omniroute-server-production-eea0.up.railway.app/v1
OMNI_API_KEY_1=
OMNI_API_KEY_2=
OPENROUTER_API_KEY=
DEEPGRAM_API_KEY=

# Only needed for trusted backend jobs that intentionally bypass RLS. Never
# prefix this with VITE_ or expose it to an app client. The app does not need it.
# SUPABASE_SECRET_KEY=sb_secret_...
